@startuml toml-merge-domain
' GENERATED by tools/model_gen.rb from doc/model/model.yml. Do not edit.
skinparam classAttributeIconSize 0
hide empty members
title toml-merge: Core domain

package domain {
  ' Builder holding the marker and the rename rules.
  class MergeOptions {
    + marker : String = "#:"
    --
    + {static} new() : MergeOptions
    + marker(marker : String) : MergeOptions
    + migrate(from : String, to : String) : MergeOptions
    + merge(default_src : String, user_src : String) : Result<Merged, Error>
  }
  ' One rename rule, applied before the merge walk.
  class Migration {
    + from : DottedPath
    + to : DottedPath
  }
  ' A key path such as server.timeout.
  class DottedPath {
    + segments : String [*]
    --
    + to_string() : String
  }
  ' Walks the default document as the spine and transplants user values.
  class MergeEngine {
    + run(options : MergeOptions) : Merged
    + walk_table(path : DottedPath) : Table
    + append_unknown() : void
    + renumber_positions() : void
  }
  ' Byte spans harvested from the user document before it is converted to DocumentMut, which discards them.
  class SpanIndex {
    + {static} harvest(user_src : String) : SpanIndex
    + lookup(path : DottedPath) : Span
  }
  class Span {
    + start : usize
    + end : usize
    --
    + line_column(source : String) : Position
  }
  class Position {
    + line : usize
    + column : usize
  }
  ' The merged document and its report. Also the effective configuration, because every default key is materialised with a live value.
  class Merged {
    + document() : DocumentMut
    + to_toml_string() : String
  }
  class Report {
    + diagnostics() : Diagnostic [*]
    + has_errors() : boolean
  }
  class Diagnostic {
    + path : DottedPath
    + line : usize
    + column : usize
  }
  abstract class DiagnosticKind <<rust enum>> {
  }
  ' The defaults do not declare this key. Warning.
  class UnknownKey {
  }
  ' The user's value has a different TOML type from the default's. Error.
  class TypeMismatch {
    + expected : TomlType
    + found : TomlType
  }
  ' A rename rule moved this value. Warning.
  class Migrated {
    + from : DottedPath
  }
  abstract class Error <<rust enum>> {
  }
  class DefaultParseError {
    + source : TomlError
  }
  class UserParseError {
    + source : TomlError
  }
  enum Severity {
    Warning
    Error
  }
  enum TomlType {
    String
    Integer
    Float
    Boolean
    Datetime
    Array
    InlineTable
    Table
    ArrayOfTables
  }
}

package toml_edit <<external>> {
  class DocumentMut
  class Table
  class TomlError
}

package decor <<external>> {
  class DocBlock
}

MergeOptions *-- "*" Migration : migrations
Merged *-- "1" Report : report
Report *-- "*" Diagnostic : diagnostics
Diagnostic *-- "1" DiagnosticKind : kind
Diagnostic --> "1" Severity : severity
SpanIndex *-- "*" Span : spans
Merged --> "1" DocumentMut : document
UnknownKey --|> DiagnosticKind
TypeMismatch --|> DiagnosticKind
Migrated --|> DiagnosticKind
DefaultParseError --|> Error
UserParseError --|> Error
MergeEngine ..> SpanIndex : harvests
MergeEngine ..> Merged : produces
MergeEngine ..> DocBlock : assembles
MergeOptions ..> MergeEngine : drives
@enduml
